---
import "../styles/global.css";
---

<html lang="en" class="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Code Sharing</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;900&family=Manrope:wght@200;300;400;500;600;700;800&family=Inter:wght@100;200;300;400;500;600;700;800;900&family=Fira+Code:wght@300;400;500&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="app-body h-screen min-h-0 overflow-hidden bg-(--color-surface) text-(--color-on-surface) font-body">
        <div class="app-shell h-full min-h-0">
            <slot />
        </div>
    </body>
</html>
